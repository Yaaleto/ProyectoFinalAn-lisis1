<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#2514eb">
        <title>{% block title %}BOVITRACK{% endblock %}</title>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen" data-controller="navigation">
        <a class="sr-only z-50 bg-surface px-4 py-3 focus:not-sr-only focus:fixed focus:left-4 focus:top-4" href="#main-content">Saltar al contenido principal</a>

        <header class="sticky top-0 z-30 flex h-16 items-center border-b border-surface-muted bg-surface px-4 shadow-sm lg:px-6">
            <button class="mr-3 inline-flex size-11 items-center justify-center rounded-md text-ink hover:bg-surface-muted lg:hidden"
                    type="button" aria-label="Abrir navegación" aria-controls="primary-navigation" aria-expanded="false"
                    data-navigation-target="openButton" data-action="navigation#open">
                <twig:Icon name="navigation" />
            </button>
            <a class="text-lg font-semibold tracking-tight text-brand" href="{{ path('app_health') }}">BOVITRACK</a>
            <div class="ml-auto flex items-center gap-3">
                <div class="hidden text-right sm:block">
                    <p class="text-sm font-medium">{{ app.user.organizacion.nombre }}</p>
                    <p class="text-xs text-ink-muted">{{ app.user.rol == 'ADMINISTRADOR' ? 'Administrador' : 'Encargado de finca' }}</p>
                </div>
                <span class="inline-flex size-10 items-center justify-center rounded-full bg-surface-muted text-ink" aria-hidden="true">
                    <twig:Icon name="person" className="size-5" />
                </span>
                <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="rounded-md px-3 py-2 text-sm font-medium text-ink-muted hover:bg-surface-muted hover:text-ink" type="submit">Cerrar sesión</button>
                </form>
            </div>
        </header>

        <div class="fixed inset-0 z-30 hidden bg-ink/40 lg:hidden" data-navigation-target="backdrop"
             data-action="click->navigation#close" aria-hidden="true"></div>

        <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-screen-2xl">
            <aside id="primary-navigation"
                   class="fixed inset-y-0 left-0 z-40 hidden w-72 overflow-y-auto border-r border-surface-muted bg-surface p-4 shadow-surface lg:sticky lg:top-16 lg:block lg:h-[calc(100vh-4rem)] lg:w-64 lg:shadow-none"
                   data-navigation-target="drawer" aria-label="Navegación principal">
                <div class="mb-5 flex items-center justify-between lg:hidden">
                    <span class="font-semibold text-brand">BOVITRACK</span>
                    <button class="inline-flex size-11 items-center justify-center rounded-md hover:bg-surface-muted"
                            type="button" aria-label="Cerrar navegación" data-action="navigation#close">
                        <twig:Icon name="dismiss" />
                    </button>
                </div>
                <nav>
                    <ul class="space-y-1" role="list">
                        <li><twig:NavItem label="Dashboard" icon="home" href="{{ path('app_health') }}" active="{{ app.current_route == 'app_health' }}" /></li>
                        <li><twig:NavItem label="Animales" icon="database" /></li>
                        <li><twig:NavItem label="Fincas" icon="building" href="{{ path('app_farm_index') }}" active="{{ app.current_route starts with 'app_farm_' }}" /></li>
                        <li><twig:NavItem label="Pesajes" icon="ruler" /></li>
                        <li><twig:NavItem label="Vacunaciones" icon="syringe" /></li>
                        <li><twig:NavItem label="Reproducción" icon="calendar" /></li>
                        <li><twig:NavItem label="Leche" icon="drop" /></li>
                        <li><twig:NavItem label="Usuarios" icon="people" href="{{ is_granted('ROLE_ADMINISTRADOR') ? path('app_user_index') : null }}" active="{{ app.current_route starts with 'app_user_' }}" /></li>
                        <li><twig:NavItem label="Catálogos" icon="settings" href="{{ path('app_breed_index') }}" active="{{ app.current_route starts with 'app_breed_' }}" /></li>
                    </ul>
                </nav>
            </aside>

            <main id="main-content" class="min-w-0 flex-1 p-4 sm:p-6 lg:p-8" tabindex="-1">
                {% for message in app.flashes('success') %}
                    <div class="mx-auto mb-6 max-w-5xl rounded-md border border-success/30 bg-success/10 p-3 text-sm text-success" role="status">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('warning') %}
                    <div class="mx-auto mb-6 max-w-5xl rounded-md border border-warning/30 bg-warning/10 p-3 text-sm text-warning" role="alert">{{ message }}</div>
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
