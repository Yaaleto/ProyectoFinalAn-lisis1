{% extends 'base.html.twig' %}

{% block title %}Registrar animal · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_animal_index') }}">← Volver a animales</a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Registrar animal</h1>
        <p class="mt-2 text-sm text-ink-muted">El registro quedará asociado a {{ app.user.organizacion.nombre }}.</p>

        {{ form_start(form, {attr: {class: 'mt-6 space-y-5 rounded-lg border border-surface-muted bg-surface p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}

            {% for field in [form.codigoInterno, form.arete, form.nombre, form.finca, form.raza, form.sexo, form.fechaNacimiento, form.pesoNacimientoKg, form.origen, form.procedencia] %}
                <div>
                    {{ form_label(field, null, {label_attr: {class: 'mb-2 block text-sm font-semibold'}}) }}
                    {{ form_widget(field, {attr: {class: 'min-h-11 w-full rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink'}}) }}
                    {{ form_help(field, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}

            <div>
                <div class="flex items-center gap-3">
                    {{ form_widget(form.productoraLeche) }}
                    {{ form_label(form.productoraLeche, null, {label_attr: {class: 'text-sm font-semibold'}}) }}
                </div>
                {{ form_help(form.productoraLeche, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                {{ form_errors(form.productoraLeche) }}
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted" href="{{ path('app_animal_index') }}">Cancelar</a>
                <button class="min-h-11 rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" type="submit">Registrar animal</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
