{% extends 'base.html.twig' %}

{% block title %}{{ animal.nombre ?: animal.arete ?: 'Animal' }} · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_animal_index') }}">← Volver a animales</a>

        <div class="mt-6 flex flex-col items-start gap-4 sm:flex-row sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Perfil del animal</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{{ animal.nombre ?: animal.arete ?: 'Animal sin identificar' }}</h1>
                <p class="mt-2 text-sm text-ink-muted">{{ animal.finca.nombre }}</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md border border-surface-muted bg-surface px-4 py-2 text-sm font-semibold text-ink shadow-sm hover:bg-surface-muted" href="{{ path('app_animal_edit', {animal: animal.id}) }}">Editar</a>
        </div>

        <div class="mt-6 flex flex-col gap-4 sm:flex-row">
            {% set identificationDetails = {
                'Arete': animal.arete ?: 'Sin arete',
                'Nombre': animal.nombre ?: 'Sin nombre',
                'Finca': animal.finca.nombre,
                'Raza': animal.raza ? animal.raza.nombre : 'Sin raza',
                'Sexo': animal.sexo == 'HEMBRA' ? 'Hembra' : 'Macho',
                'Estado': animal.estado|lower|capitalize
            } %}
            {% set originDetails = {
                'Fecha de nacimiento': animal.fechaNacimiento ? animal.fechaNacimiento|date('d/m/Y') : 'Sin registrar',
                'Peso al nacimiento': animal.pesoNacimientoKg ? animal.pesoNacimientoKg ~ ' kg' : 'Sin registrar',
                'Origen': animal.origen == 'NACIDO_EN_FINCA' ? 'Nacido en finca' : 'Externo',
                'Procedencia': animal.procedencia ?: 'Sin registrar',
                'Productora de leche': animal.productoraLeche ? 'Sí' : 'No'
            } %}

            {% for section in [
                {title: 'Identificación', description: 'Datos principales y ubicación actual.', details: identificationDetails},
                {title: 'Nacimiento y origen', description: 'Información de procedencia y producción.', details: originDetails}
            ] %}
                <section class="flex-1 overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm" aria-labelledby="animal-section-{{ loop.index }}">
                    <div class="p-5">
                        <h2 class="text-lg font-semibold" id="animal-section-{{ loop.index }}">{{ section.title }}</h2>
                        <p class="mt-1 text-sm text-ink-muted">{{ section.description }}</p>
                    </div>
                    <dl>
                        {% for label, value in section.details %}
                            <div class="flex items-start justify-between gap-4 border-t border-surface-muted px-4 py-3">
                                <dt class="text-sm text-ink-muted">{{ label }}</dt>
                                <dd class="text-right text-sm font-semibold text-ink">{{ value }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                </section>
            {% endfor %}
        </div>
    </div>
{% endblock %}
