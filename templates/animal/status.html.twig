{% extends 'base.html.twig' %}

{% block title %}Cambiar estado · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_animal_show', {animal: animal.id}) }}">← Volver al perfil</a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">Cambiar estado</h1>
        <p class="mt-2 text-sm text-ink-muted">
            {{ animal.nombre ?: 'Arete ' ~ animal.arete }} · estado actual: {{ animal.estado|lower|capitalize }}{% if animal.fechaSalida %}, salida el {{ animal.fechaSalida|date('d/m/Y') }}{% endif %}.
        </p>

        <p class="mt-6 text-sm text-ink-muted">Los campos marcados con * son obligatorios.</p>

        {{ form_start(form, {attr: {class: 'mt-4 space-y-5 rounded-lg border border-surface-muted bg-surface p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}

            {% for field in [form.estado, form.fechaSalida] %}
                <div>
                    {{ form_label(field, null, {label_attr: {class: 'mb-2 block text-sm font-semibold'}}) }}
                    {{ form_widget(field, {attr: {class: 'min-h-11 w-full rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink'}}) }}
                    {{ form_help(field, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}

            <p class="text-xs text-ink-muted">Desde la fecha de salida no se admiten registros operativos posteriores. El historial del animal se conserva.</p>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted" href="{{ path('app_animal_show', {animal: animal.id}) }}">Cancelar</a>
                <button class="min-h-11 rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" type="submit">Guardar estado</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
