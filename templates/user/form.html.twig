{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_user_index') }}">← Volver a usuarios</a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{{ page_title }}</h1>
        <p class="mt-2 text-sm text-ink-muted">La cuenta quedará asociada a {{ app.user.organizacion.nombre }}.</p>

        {{ form_start(form, {attr: {class: 'mt-6 space-y-5 rounded-lg border border-surface-muted bg-surface p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}

            {% for field in [form.nombre, form.email, form.rol, form.fincaActiva, form.plainPassword] %}
                <div>
                    {{ form_label(field, null, {label_attr: {class: 'mb-2 block text-sm font-semibold'}}) }}
                    {{ form_widget(field, {attr: {class: 'min-h-11 w-full rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink'}}) }}
                    {{ form_help(field, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}

            <div class="rounded-md border border-surface-muted p-4">
                <div class="flex items-start gap-3">
                    {{ form_widget(form.activo, {attr: {class: 'mt-1 size-4 rounded border-surface-muted text-brand'}}) }}
                    <div>
                        {{ form_label(form.activo, null, {label_attr: {class: 'text-sm font-semibold'}}) }}
                        {{ form_help(form.activo, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                        {{ form_errors(form.activo) }}
                    </div>
                </div>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted" href="{{ path('app_user_index') }}">Cancelar</a>
                <button class="min-h-11 rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" type="submit">{{ submit_label }}</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
