{% extends 'base.html.twig' %}

{% block title %}Usuarios · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Administración</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Usuarios</h1>
                <p class="mt-2 text-sm text-ink-muted">Cuentas registradas en {{ app.user.organizacion.nombre }}.</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_user_new') }}">Nuevo usuario</a>
        </div>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if usuarios is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay usuarios registrados.</p>
                    <p class="mt-2 text-sm text-ink-muted">Crea la primera cuenta para comenzar.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Usuario</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Rol</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Finca activa</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Estado</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for usuario in usuarios %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3">
                                        <p class="font-medium">{{ usuario.nombre }}</p>
                                        <p class="text-xs text-ink-muted">{{ usuario.email }}</p>
                                    </td>
                                    <td class="px-4 py-3 text-ink-muted">{{ usuario.rol == 'ADMINISTRADOR' ? 'Administrador' : 'Encargado' }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ usuario.fincaActiva ? usuario.fincaActiva.nombre : '—' }}</td>
                                    <td class="px-4 py-3">
                                        {% if usuario.activo %}
                                            <span class="inline-flex rounded-full bg-success/10 px-2.5 py-1 text-xs font-semibold text-success">Activa</span>
                                        {% else %}
                                            <span class="inline-flex rounded-full bg-ink-muted/10 px-2.5 py-1 text-xs font-semibold text-ink-muted">Inactiva</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <a class="font-semibold text-brand hover:underline" href="{{ path('app_user_edit', {usuario: usuario.id}) }}">Editar</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
