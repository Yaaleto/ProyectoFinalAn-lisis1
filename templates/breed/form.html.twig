{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_breed_index') }}">← Volver a razas</a>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{{ page_title }}</h1>
        <p class="mt-2 text-sm text-ink-muted">Los datos quedarán asociados a {{ app.user.organizacion.nombre }}.</p>

        {{ form_start(form, {attr: {class: 'mt-6 space-y-5 rounded-lg border border-surface-muted bg-surface p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}
            <div>
                {{ form_label(form.nombre, null, {label_attr: {class: 'mb-2 block text-sm font-semibold'}}) }}
                {{ form_widget(form.nombre, {attr: {class: 'min-h-11 w-full rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink'}}) }}
                {{ form_help(form.nombre, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                {{ form_errors(form.nombre) }}
            </div>

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted" href="{{ path('app_breed_index') }}">Cancelar</a>
                <button class="min-h-11 rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" type="submit">{{ submit_label }}</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
