{% extends 'base.html.twig' %}

{% block title %}Razas · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Catálogos</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Razas</h1>
                <p class="mt-2 text-sm text-ink-muted">Razas registradas en {{ app.user.organizacion.nombre }}.</p>
            </div>
            {% if canManage %}
                <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_breed_new') }}">Nueva raza</a>
            {% endif %}
        </div>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if razas is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay razas registradas.</p>
                    <p class="mt-2 text-sm text-ink-muted">Crea la primera raza para comenzar.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Nombre</th>
                                {% if canManage %}
                                    <th class="px-4 py-3 font-semibold" scope="col">Estado</th>
                                    <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for raza in razas %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3 font-medium">{{ raza.nombre }}</td>
                                    {% if canManage %}
                                        <td class="px-4 py-3 text-ink-muted">{{ raza.activa ? 'Activa' : 'Inactiva' }}</td>
                                        <td class="px-4 py-3 text-right">
                                            <a class="mr-4 font-semibold text-brand hover:underline" href="{{ path('app_breed_edit', {raza: raza.id}) }}">Editar</a>
                                            <form class="inline" method="post" action="{{ path('app_breed_toggle_status', {raza: raza.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-breed-' ~ raza.id) }}">
                                                <button class="font-semibold text-brand hover:underline" type="submit">{{ raza.activa ? 'Desactivar' : 'Activar' }}</button>
                                            </form>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
