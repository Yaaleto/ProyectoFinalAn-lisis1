{% extends 'base.html.twig' %}

{% block title %}Reproducción · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Registros operativos</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Montas</h1>
                <p class="mt-2 text-sm text-ink-muted">Montas más recientes según tu organización y finca asignada.</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_mating_new') }}">Registrar monta</a>
        </div>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if montas is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay montas registradas.</p>
                    <p class="mt-2 text-sm text-ink-muted">Registra la primera monta para comenzar el historial reproductivo.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Fecha</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Hembra</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Finca</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Macho</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for monta in montas %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3 font-medium">{{ monta.fecha|date('d/m/Y') }}</td>
                                    <td class="px-4 py-3">{{ monta.hembra.arete }}{% if monta.hembra.nombre %} · {{ monta.hembra.nombre }}{% endif %}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ monta.hembra.finca.nombre }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ monta.macho ? monta.macho.arete : 'Sin registrar' }}</td>
                                    <td class="px-4 py-3 text-right">
                                        <a class="font-semibold text-brand hover:underline" href="{{ path('app_mating_history', {animal: monta.hembra.id}) }}">Historial</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
