{% extends 'base.html.twig' %}

{% block title %}Historial reproductivo · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_animal_show', {animal: animal.id}) }}">← Volver al perfil</a>

        <div class="mt-6 mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Historial reproductivo</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{{ animal.nombre ?: 'Arete ' ~ animal.arete }}</h1>
                <p class="mt-2 text-sm text-ink-muted">Arete {{ animal.arete }} · {{ animal.finca.nombre }} · {{ animal.sexo == 'HEMBRA' ? 'montas como hembra' : 'montas como macho' }}, en orden cronológico.</p>
            </div>
            {% if animal.sexo == 'HEMBRA' and animal.finca.activo %}
                <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_mating_new', {animal: animal.id}) }}">Registrar monta</a>
            {% endif %}
        </div>

        {% if not animal.finca.activo %}
            <p class="mb-4 rounded-md border border-surface-muted bg-surface-muted p-3 text-sm text-ink-muted" role="note">La finca está inactiva; su historial es de solo lectura.</p>
        {% endif %}

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if montas is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Este animal todavía no tiene montas registradas.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Fecha</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Hembra</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Macho</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Observación</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for monta in montas %}
                                <tr class="border-t border-surface-muted" data-mating-row>
                                    <td class="px-4 py-3 font-medium">{{ monta.fecha|date('d/m/Y') }}</td>
                                    <td class="px-4 py-3">{{ monta.hembra.arete }}</td>
                                    <td class="px-4 py-3">
                                        {% if monta.macho %}
                                            {{ monta.macho.arete }}
                                            {% if monta.macho.finca != monta.hembra.finca %}<span class="ml-1 text-xs text-ink-muted">({{ monta.macho.finca.nombre }})</span>{% endif %}
                                        {% else %}
                                            <span class="text-ink-muted">Sin registrar</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 text-ink-muted">{{ monta.observacion ?: '—' }}</td>
                                    <td class="px-4 py-3 text-right">
                                        {% if monta.hembra.finca.activo %}
                                            <div class="inline-flex items-center gap-3">
                                                <a class="font-semibold text-brand hover:underline" href="{{ path('app_mating_edit', {monta: monta.id}) }}">Editar</a>
                                                {% if is_granted('ROLE_ADMINISTRADOR') %}
                                                    <form method="post" action="{{ path('app_mating_delete', {monta: monta.id}) }}" onsubmit="return confirm('¿Eliminar esta monta?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-mating-' ~ monta.id) }}">
                                                        <button class="font-semibold text-danger hover:underline" type="submit">Eliminar</button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        {% else %}
                                            <span class="text-ink-muted">Solo lectura</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
