{% extends 'base.html.twig' %}

{% block title %}Pesajes · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Registros operativos</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Pesajes</h1>
                <p class="mt-2 text-sm text-ink-muted">Pesajes más recientes según tu organización y finca asignada.</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_weight_new') }}">Registrar pesaje</a>
        </div>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if pesajes is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay pesajes registrados.</p>
                    <p class="mt-2 text-sm text-ink-muted">Registra el primer pesaje para comenzar el historial.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Fecha</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Arete</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Animal</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Finca</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Peso</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for pesaje in pesajes %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3 font-medium">{{ pesaje.fecha|date('d/m/Y') }}</td>
                                    <td class="px-4 py-3">{{ pesaje.animal.arete }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ pesaje.animal.nombre ?: 'Sin nombre' }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ pesaje.animal.finca.nombre }}</td>
                                    <td class="px-4 py-3 text-right">{{ pesaje.pesoKg|number_format(2, '.', ',') }} kg</td>
                                    <td class="px-4 py-3 text-right">
                                        <a class="font-semibold text-brand hover:underline" href="{{ path('app_weight_history', {animal: pesaje.animal.id}) }}">Historial</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
