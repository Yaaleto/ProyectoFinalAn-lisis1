{% extends 'base.html.twig' %}

{% block title %}Dashboard · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <div class="mb-6">
            <p class="text-sm font-semibold text-brand">Resumen</p>
            <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Bienvenido a BOVITRACK</h1>
            <p class="mt-2 max-w-2xl text-ink-muted">La base de la aplicación está lista para los flujos de gestión ganadera.</p>
        </div>

        <section class="rounded-lg border border-surface-muted bg-surface p-5 shadow-surface sm:p-6" aria-labelledby="system-status-title">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="system-status-title" class="text-lg font-semibold">Estado del sistema</h2>
                    <p class="mt-1 text-sm text-ink-muted">Symfony y el servicio local de datos están disponibles.</p>
                </div>
                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-success/10 px-3 py-1.5 text-sm font-semibold text-success">
                    <span class="size-2 rounded-full bg-success" aria-hidden="true"></span>
                    {{ databaseConnected ? 'Conectado' : 'No disponible' }}
                </span>
            </div>
        </section>
    </div>
{% endblock %}
