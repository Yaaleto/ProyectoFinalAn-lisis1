{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        {% if ordeno %}
            <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_milk_history', {animal: ordeno.animal.id}) }}">← Volver al historial</a>
        {% else %}
            <a class="text-sm font-semibold text-brand hover:underline" href="{{ path('app_milk_index') }}">← Volver a producción de leche</a>
        {% endif %}
        <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{{ page_title }}</h1>
        <p class="mt-2 text-sm text-ink-muted">
            {% if ordeno %}
                {{ ordeno.animal.nombre ?: 'Arete ' ~ ordeno.animal.arete }} · finca actual: {{ ordeno.animal.finca.nombre }}
            {% else %}
                Solo hembras activas marcadas como productoras. Se admiten varios ordeños del mismo animal en un día.
            {% endif %}
        </p>

        {{ form_start(form, {attr: {class: 'mt-6 space-y-5 rounded-lg border border-surface-muted bg-surface p-6 shadow-sm'}}) }}
            {{ form_errors(form) }}

            {% for field in form|filter(field => not field.rendered and field.vars.name != '_token') %}
                <div>
                    {{ form_label(field, null, {label_attr: {class: 'mb-2 block text-sm font-semibold'}}) }}
                    {{ form_widget(field, {attr: {class: 'min-h-11 w-full rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink'}}) }}
                    {{ form_help(field, {help_attr: {class: 'mt-1 text-xs text-ink-muted'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endfor %}

            <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
                <a class="inline-flex min-h-11 items-center justify-center rounded-md px-4 py-2.5 text-sm font-semibold text-ink hover:bg-surface-muted" href="{{ ordeno ? path('app_milk_history', {animal: ordeno.animal.id}) : path('app_milk_index') }}">Cancelar</a>
                <button class="min-h-11 rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" type="submit">{{ submit_label }}</button>
            </div>
        {{ form_end(form) }}
    </div>

    <script>
        // Al elegir la hembra se propone su finca actual como finca del ordeño; el usuario puede cambiarla.
        (() => {
            const animal = document.querySelector('[data-milk-animal]');
            const finca = document.querySelector('[data-milk-farm]');
            if (!animal || !finca) {
                return;
            }
            animal.addEventListener('change', () => {
                const propuesta = animal.selectedOptions[0]?.dataset.fincaActual;
                if (propuesta && finca.querySelector(`option[value="${propuesta}"]`)) {
                    finca.value = propuesta;
                }
            });
        })();
    </script>
{% endblock %}
