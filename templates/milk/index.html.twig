{% extends 'base.html.twig' %}

{% block title %}Producción de leche · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Registros operativos</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Producción de leche</h1>
                <p class="mt-2 text-sm text-ink-muted">Totales por la finca donde ocurrió cada ordeño y ordeños recientes de tu ámbito.</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_milk_new') }}">Registrar ordeño</a>
        </div>

        <section class="mb-6 overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm" aria-labelledby="milk-farm-totals">
            <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h2 class="text-lg font-semibold" id="milk-farm-totals">Total por finca</h2>
                    <p class="mt-1 text-sm text-ink-muted">Usa la finca del ordeño, así que no cambia si el animal se traslada.</p>
                </div>
                <form method="get" action="{{ path('app_milk_index') }}" class="flex items-end gap-2">
                    <label class="text-sm font-semibold" for="milk-day">Día
                        <input class="mt-1 block min-h-11 rounded-md border border-surface-muted bg-surface px-3 py-2 text-ink" id="milk-day" type="date" name="fecha" value="{{ dia|date('Y-m-d') }}" max="{{ 'today'|date('Y-m-d') }}">
                    </label>
                    <button class="min-h-11 rounded-md border border-surface-muted px-4 py-2 text-sm font-semibold text-ink hover:bg-surface-muted" type="submit">Ver</button>
                </form>
            </div>
            {% if totalesPorFinca is empty %}
                <p class="border-t border-surface-muted p-5 text-sm text-ink-muted">No hay ordeños registrados el {{ dia|date('d/m/Y') }}.</p>
            {% else %}
                <table class="w-full text-left text-sm">
                    <thead class="bg-surface-muted text-ink-muted">
                        <tr>
                            <th class="px-4 py-3 font-semibold" scope="col">Finca del ordeño</th>
                            <th class="px-4 py-3 text-right font-semibold" scope="col">Ordeños</th>
                            <th class="px-4 py-3 text-right font-semibold" scope="col">Litros</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for total in totalesPorFinca %}
                            <tr class="border-t border-surface-muted" data-farm-total>
                                <td class="px-4 py-3 font-medium">{{ total.finca }}</td>
                                <td class="px-4 py-3 text-right">{{ total.ordenos }}</td>
                                <td class="px-4 py-3 text-right font-semibold">{{ total.litros|number_format(2, '.', ',') }} L</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if ordenos is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay ordeños registrados.</p>
                    <p class="mt-2 text-sm text-ink-muted">Registra el primer ordeño para comenzar el historial.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Fecha y hora</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Arete</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Animal</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Finca del ordeño</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Litros</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ordeno in ordenos %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3 font-medium">{{ ordeno.fechaHora|date('d/m/Y H:i') }}</td>
                                    <td class="px-4 py-3">{{ ordeno.animal.arete }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ ordeno.animal.nombre ?: 'Sin nombre' }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ ordeno.fincaOrdeno.nombre }}</td>
                                    <td class="px-4 py-3 text-right">{{ ordeno.cantidadLitros|number_format(2, '.', ',') }} L</td>
                                    <td class="px-4 py-3 text-right">
                                        <a class="font-semibold text-brand hover:underline" href="{{ path('app_milk_history', {animal: ordeno.animal.id}) }}">Historial</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
