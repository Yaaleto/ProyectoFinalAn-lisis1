{# Tema de formularios de BOVITRACK: errores visibles y accesibles (RNF-P-05). #}
{% use 'form_div_layout.html.twig' %}

{%- block form_errors -%}
    {%- for error in errors -%}
        <p id="{{ id ~ '_error' ~ loop.index }}" class="form-error mt-2 flex items-start gap-2 rounded-md border border-danger/30 bg-danger/10 px-3 py-2 text-base font-semibold text-danger" role="alert">
            <span aria-hidden="true">⚠</span>
            <span>{{ error.message }}</span>
        </p>
    {%- endfor -%}
{%- endblock form_errors -%}

{%- block widget_attributes -%}
    {{- parent() -}}
    {%- if not valid %} aria-invalid="true"{% if errors|length > 0 %} aria-errormessage="{{ id ~ '_error1' }}"{% endif %}{% endif -%}
{%- endblock widget_attributes -%}
