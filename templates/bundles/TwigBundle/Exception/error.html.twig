{# Página de error para el usuario. Symfony la usa en producción; en desarrollo se ve en /_error/<código>. #}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#2514eb">
        <title>{% block titulo %}Ocurrió un error{% endblock %} · BOVITRACK</title>
        {{ importmap('app') }}
    </head>
    <body class="flex min-h-screen items-center justify-center p-4">
        <main class="w-full max-w-lg rounded-lg border border-surface-muted bg-surface p-8 text-center shadow-sm">
            <p class="text-lg font-semibold tracking-tight text-brand">BOVITRACK</p>
            <p class="mt-6 text-5xl font-semibold text-ink-muted">{{ status_code }}</p>
            <h1 class="mt-4 text-2xl font-semibold tracking-tight">{{ block('titulo') }}</h1>
            <p class="mt-3 text-base text-ink-muted">
                {%- block mensaje -%}
                    No pudimos completar la acción. Intenta de nuevo en unos minutos; si el problema continúa, avisa al administrador del sistema.
                {%- endblock -%}
            </p>
            <a class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-5 py-2.5 text-base font-semibold text-white hover:bg-brand-hover" href="{{ path('app_health') }}">Volver al inicio</a>
        </main>
    </body>
</html>
