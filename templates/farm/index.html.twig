{% extends 'base.html.twig' %}

{% block title %}Fincas · BOVITRACK{% endblock %}

{% block body %}
    <div class="mx-auto max-w-5xl">
        <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-semibold text-brand">Administración</p>
                <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Fincas</h1>
                <p class="mt-2 text-sm text-ink-muted">Fincas registradas en {{ app.user.organizacion.nombre }}.</p>
            </div>
            <a class="inline-flex min-h-11 items-center justify-center rounded-md bg-brand px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-hover" href="{{ path('app_farm_new') }}">Nueva finca</a>
        </div>

        <div class="overflow-hidden rounded-lg border border-surface-muted bg-surface shadow-sm">
            {% if fincas is empty %}
                <div class="p-6 text-center">
                    <p class="font-medium">Todavía no hay fincas registradas.</p>
                    <p class="mt-2 text-sm text-ink-muted">Crea la primera finca para comenzar.</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-surface-muted text-ink-muted">
                            <tr>
                                <th class="px-4 py-3 font-semibold" scope="col">Nombre</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Código</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Ubicación</th>
                                <th class="px-4 py-3 font-semibold" scope="col">Estado</th>
                                <th class="px-4 py-3 text-right font-semibold" scope="col">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for finca in fincas %}
                                <tr class="border-t border-surface-muted">
                                    <td class="px-4 py-3 font-medium">{{ finca.nombre }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ finca.codigo }}</td>
                                    <td class="px-4 py-3 text-ink-muted">{{ finca.ubicacion ?: '—' }}</td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold {{ finca.activo ? 'bg-success/10 text-success' : 'bg-ink-muted/10 text-ink-muted' }}">{{ finca.activo ? 'Activa' : 'Inactiva' }}</span>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <a class="font-semibold text-brand hover:underline" href="{{ path('app_farm_edit', {finca: finca.id}) }}">Editar</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
